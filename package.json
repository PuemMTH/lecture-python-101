{
  "name": "python-basic-slides",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "slidev slides.md",
    "dev:01": "slidev 01-python-basics-and-sequential-programming.md",
    "dev:02": "slidev 02-functions.md",
    "dev:03": "slidev 03-booleans-and-conditionals.md",
    "dev:04": "slidev 04-errors-and-exceptions.md",
    "dev:05": "slidev 05-lists-and-dictionaries.md",
    "dev:06": "slidev 06-loops-and-collection-processing.md",
    "dev:07": "slidev 07-files-and-data-project.md",
    "build": "slidev build slides.md --out dist/course",
    "build:sessions": "pnpm run build:01 && pnpm run build:02 && pnpm run build:03 && pnpm run build:04 && pnpm run build:05 && pnpm run build:06 && pnpm run build:07",
    "build:01": "slidev build 01-python-basics-and-sequential-programming.md --out dist/01-python-basics-and-sequential-programming",
    "build:02": "slidev build 02-functions.md --out dist/02-functions",
    "build:03": "slidev build 03-booleans-and-conditionals.md --out dist/03-booleans-and-conditionals",
    "build:04": "slidev build 04-errors-and-exceptions.md --out dist/04-errors-and-exceptions",
    "build:05": "slidev build 05-lists-and-dictionaries.md --out dist/05-lists-and-dictionaries",
    "build:06": "slidev build 06-loops-and-collection-processing.md --out dist/06-loops-and-collection-processing",
    "build:07": "slidev build 07-files-and-data-project.md --out dist/07-files-and-data-project"
  },
  "dependencies": {
    "@slidev/cli": "52.18.0",
    "@slidev/types": "52.18.0",
    "pyodide": "314.0.2",
    "slidev-theme-geist": "0.8.1"
  }
}
