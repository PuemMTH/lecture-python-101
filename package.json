{
  "name": "python-basic-slides",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "slidev slides.md",
    "dev:01": "slidev session-01.md",
    "dev:02": "slidev session-02.md",
    "dev:03": "slidev session-03.md",
    "dev:04": "slidev session-04.md",
    "dev:05": "slidev session-05.md",
    "dev:06": "slidev session-06.md",
    "build": "slidev build slides.md --out dist/course",
    "build:sessions": "pnpm run build:01 && pnpm run build:02 && pnpm run build:03 && pnpm run build:04 && pnpm run build:05 && pnpm run build:06",
    "build:01": "slidev build session-01.md --out dist/session-01",
    "build:02": "slidev build session-02.md --out dist/session-02",
    "build:03": "slidev build session-03.md --out dist/session-03",
    "build:04": "slidev build session-04.md --out dist/session-04",
    "build:05": "slidev build session-05.md --out dist/session-05",
    "build:06": "slidev build session-06.md --out dist/session-06"
  },
  "dependencies": {
    "@slidev/cli": "52.18.0",
    "@slidev/types": "52.18.0",
    "pyodide": "314.0.2",
    "slidev-theme-geist": "0.8.1"
  }
}
